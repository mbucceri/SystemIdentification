  <joint name="starman_arm_wrist2_end_effector" type="fixed">
    <parent link="starman_arm_wrist_link_2"/>
    <child link="starman_arm_end_effector"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <link name="starman_arm_jaw_link"/>
  <joint name="starman_arm_jaw" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1.0" lower="-0.2" upper="0.8" velocity="5.0"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="starman_arm_wrist_link_2"/>
    <child link="starman_arm_jaw_link"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
</robot>
