{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "identify",
      "type": "python", // python to run without the debugger, debugpy to run with the debugger
      "request": "launch",
      "program": "${workspaceFolder}/src/VerticalJointId/identification/identify.py",
      "args": ["--gtPath", "${workspaceFolder}/src/VerticalJointId/experiments/01-MultiSineTelemetry_groundTruth.csv"],
      "cwd": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Run Model - Ground Truth",
      "type": "python", // python to run withou the debugger, debugpy to run with the debugger
      "request": "launch",
      "program": "${workspaceFolder}/src/VerticalJointId/simulation/runModel_groundTruth.py",
      "cwd": "${workspaceFolder}/src",
      "args": ["-if", "${workspaceFolder}/src/InputData/10-MultiSine/01-MultiSineInput.csv",
                "-of", "${workspaceFolder}/src/VerticalJointId/experiments/01-MultiSineTelemetry_groundTruth.csv",
                "-p"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
    },
        {
      "name": "Run Model - simplified",
      "type": "python", // python to run withou the debugger, debugpy to run with the debugger
      "request": "launch",
      "program": "${workspaceFolder}/src/VerticalJointId/simulation/runModel_simplified.py",
      "cwd": "${workspaceFolder}/src",
      "args": ["-if", "${workspaceFolder}/src/InputData/10-MultiSine/01-MultiSineInput.csv",
                "-of", "${workspaceFolder}/src/VerticalJointId/experiments/01-MultiSineTelemetry_groundTruth.csv",
                "-p"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
    },
    {
      "name": "Generate Step Input",
      "type": "python", // python to run withou the debugger, debugpy to run with the debugger
      "request": "launch",
      "program": "${workspaceFolder}/src/InputData/01-Step/generateStepData.py",
      "cwd": "${workspaceFolder}/src/InputData/01-Step",
      "args": [ "-ts", "0.001", 
                "-et", "10.0", 
                "-b", "0.8", 
                "-st", "1.0", 
                "-sh", "0.6", 
                "-of", "01-StepInput.csv"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Generate MultiSine Input",
      "type": "python", // python to run withou the debugger, debugpy to run with the debugger
      "request": "launch",
      "program": "${workspaceFolder}/src/InputData/10-MultiSine/generateMultiSineData.py",

      "args": ["-ts", "0.001",
            "-et", "10.0",
            "-b", "0.0",
            "-f", "0.2", "0.5", "0.9", "1.7", "2.8", "4.0",
            "-ph", "0.0", "1.1", "2.2", "0.7", "1.9", "2.8",
            "-a", "2.0",
            "-of", "01-MultiSineInput.csv"],
      "cwd": "${workspaceFolder}/src/InputData/10-MultiSine",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    }

  ]
}
